*.ipr

# mTLS client credentials extracted for local testing (never commit)
/ca.crt
/client.crt
/client.key
/admin.crt
/admin.key
/user.crt
/user.key
/intruder.crt
/intruder.key
# PKCS12 keystores the e2e test loads (built from the extracted certs)
/*.p12
# Scratch certificate captures from the rotation walkthrough
/old-cert.pem
